# Public URL of the app (used for SEO metadata, OAuth callbacks and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: 32+ random characters used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET=

# AI — without a key the app uses a built-in demo model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Payments — without a key checkout runs in demo mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
